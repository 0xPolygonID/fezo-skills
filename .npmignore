# Source and dev tooling — not needed by consumers of the published package;
# the runtime artifact is the committed dist/fezoctl.mjs bundle.
src/
tests/
build/
.github/

# Config and repo metadata.
tsconfig.json
vitest.config.ts
.gitattributes
.gitignore
.npmignore

# Credentials — never publish. npm has no built-in default ignore for these,
# and it stops consulting .gitignore once this file exists. package.json's
# "files" allowlist already excludes them; this is deliberate defense in depth.
.env
.env.*

# Local artifacts.
node_modules/
coverage/
*.log
.DS_Store
