dist/fezoctl.mjs linguist-generated -diff
skills/*/scripts/fezoctl.mjs linguist-generated -diff

# CI byte-compares a fresh esbuild build against the committed bundle. Any EOL
# translation (core.autocrlf, a future `* text=auto`) would make working-tree
# bytes differ from the blob and break that comparison for a non-obvious
# reason. Pin the bundle to byte-for-byte, no normalization.
#
# Both committed copies need this, not just dist/: the freshness gate diffs
# them together, and they must stay byte-identical to each other so git keeps
# storing them as a single blob.
dist/fezoctl.mjs -text
skills/*/scripts/fezoctl.mjs -text
