{
  "name": "fezo-skills",
  "version": "1.0.0",
  "description": "Agent skill and CLI (fezoctl) for discovering and calling Fezo/Zug API gateway tools from the live catalog.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/0xPolygonID/fezo-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xPolygonID/fezo-skills.git"
  },
  "bin": {
    "fezoctl": "dist/fezoctl.mjs"
  },
  "files": [
    "dist/",
    "skills/"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
